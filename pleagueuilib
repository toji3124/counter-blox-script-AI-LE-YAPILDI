local function formatKeyName(key)
	if not key or key == "" or key == false then return "None" end
	local name = tostring(key)
	if typeof(key) == "EnumItem" then
		name = key.Name
	elseif type(key) == "string" then
		local parts = string.split(key, ".")
		name = parts[#parts]
	end
	local shortcuts = {
		["RightShift"] = "RShift",
		["LeftShift"] = "LShift",
		["RightControl"] = "RCtrl",
		["LeftControl"] = "LCtrl",
		["RightAlt"] = "RAlt",
		["LeftAlt"] = "LAlt",
		["MouseButton1"] = "MB1",
		["MouseButton2"] = "MB2",
		["MouseButton3"] = "MB3",
		["MB1"] = "MB1",
		["MB2"] = "MB2",
		["MB3"] = "MB3",
		["LeftBracket"] = "[",
		["RightBracket"] = "]",
		["Backquote"] = "`",
		["CapsLock"] = "Caps",
		["Return"] = "Enter",
		["PageUp"] = "PgUp",
		["PageDown"] = "PgDn",
		["Delete"] = "Del",
		["Insert"] = "Ins",
		["Unknown"] = "None"
	}
	return shortcuts[name] or name
end

local function inputMatches(inputObj, boundKey)
	if not boundKey or boundKey == "None" or boundKey == Enum.KeyCode.Unknown then
		return false
	end
	if typeof(boundKey) == "EnumItem" then
		if inputObj.KeyCode == boundKey or inputObj.UserInputType == boundKey then
			return true
		end
		if inputObj.KeyCode ~= Enum.KeyCode.Unknown and inputObj.KeyCode.Name == boundKey.Name then
			return true
		end
		if inputObj.UserInputType.Name == boundKey.Name then
			return true
		end
	end
	local boundStr = tostring(boundKey)
	local parts = string.split(boundStr, ".")
	local rawName = parts[#parts]
	local formattedBound = formatKeyName(boundKey)

	if inputObj.KeyCode ~= Enum.KeyCode.Unknown then
		if inputObj.KeyCode.Name == rawName or formatKeyName(inputObj.KeyCode) == formattedBound or formatKeyName(inputObj.KeyCode) == boundStr then
			return true
		end
	end

	if inputObj.UserInputType.Name == rawName or formatKeyName(inputObj.UserInputType) == formattedBound or formatKeyName(inputObj.UserInputType) == boundStr then
		return true
	end

	return false
end

