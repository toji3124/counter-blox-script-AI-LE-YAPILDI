		end

		function item:SetState(newState)
			item.State = (newState == true)
			local targetDotColor = item.State and Color3.fromRGB(80, 220, 120) or Color3.fromRGB(90, 90, 90)
			local targetTextColor = item.State and Color3.fromRGB(230, 230, 230) or Color3.fromRGB(150, 150, 150)
