	function KeybindsModule:Clear()
		for _, item in pairs(KeybindsModule.Items) do
			if item and item.Frame then
				item.Frame:Destroy()
			end
		end
		KeybindsModule.Items = {}
		UpdateSize()
	end

	UpdateSize()
	return KeybindsModule
end

