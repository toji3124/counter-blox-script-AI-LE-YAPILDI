		local function getsize(str)
			local r = 0;
			for i=1,#str do
				r+=1
			end
			if r <= 5 then
				if r == 1 then
					return r * 50
				end
				if r ==2 then
					return r * 25
				end
				if r ==3 then
					return r * 16
				end
				if r == 4 then
					return r * 12
				end
				if r == 5 then
					return r * 10
				end
			end
			return r * 7.5
		end
