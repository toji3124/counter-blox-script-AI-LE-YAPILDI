function library:HitLog(target, part, damage, remaining, distance)
	return library:AddHitLog({
		Tag = "HIT",
		TagColor = Color3.fromRGB(80, 220, 120),
		Target = tostring(target or "Player"),
		Part = tostring(part or "Head"),
