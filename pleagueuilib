			}):Play()
		end)
		if not cardObj.Persistent and not cardObj.Closed then
			local remaining = math.max(0.05, cardObj.Dur - cardObj.Elapsed)
			cardObj.BarTween = TweenService:Create(Bar, TweenInfo.new(remaining, Enum.EasingStyle.Linear, Enum.EasingDirection.In), {
