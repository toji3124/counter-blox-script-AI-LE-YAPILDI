-- ── Ana Notify Çağrısı ──────────────────────────────────────────
function library:Notify(titleOrConfig, text, duration)
	local cfg = {}

	if type(titleOrConfig) == "table" then
		local t = titleOrConfig
		cfg.title      = t.Title or t.title or "Notification"
		cfg.desc       = t.Text or t.text or t.Message or t.desc or ""
		cfg.dur        = tonumber(t.Duration or t.duration or t.Time) or 2.0
		cfg.persistent = (cfg.dur == 0) or (t.Persistent == true)
		cfg.onClick    = t.OnClick or t.onClick
		cfg.unique     = t.Unique or t.new or false

		local typeKey  = t.Type or t.type
		if typeKey and NOTIFY_TYPE_COLORS[tostring(typeKey):lower()] then
			cfg.color = NOTIFY_TYPE_COLORS[tostring(typeKey):lower()]
		else
			cfg.color = t.Color or t.AccentColor or Color3.fromRGB(91, 133, 197)
		end
	elseif text ~= nil then
		cfg.title = tostring(titleOrConfig or "Notification")
		cfg.desc  = tostring(text or "")
		cfg.dur   = tonumber(duration) or 2.0
		cfg.color = Color3.fromRGB(91, 133, 197)
	else
		cfg.title = "Notification"
		cfg.desc  = tostring(titleOrConfig or "")
		cfg.dur   = tonumber(duration) or 2.0
		cfg.color = Color3.fromRGB(91, 133, 197)
	end

	if cfg.persistent then cfg.dur = cfg.dur == 0 and 9999 or cfg.dur end

	notifyCleanActive()
	if notifyActiveCount() < NOTIFY_MAX_STACK then
		return library:_ShowNotify(cfg)
	else
		NOTIFY_QUEUE[#NOTIFY_QUEUE+1] = cfg
		processQueue()
		return nil
	end
end
library.Notification = library.Notify

