local NOTIFY_MAX_STACK  = 5          -- ekranda aynı anda max bu kadar
local NOTIFY_QUEUE      = {}         -- bekleyen bildirimler
local NOTIFY_ACTIVE     = {}         -- şu an ekrandakiler (cardObj nesneleri)
local NOTIFY_PROCESSING = false      -- kuyruk işleniyor mu

-- Type → otomatik renk tablosu (Plague UI uyumlu)
local NOTIFY_TYPE_COLORS = {
	success = Color3.fromRGB(80,  220, 120),
	error   = Color3.fromRGB(220, 80,  80),
	warning = Color3.fromRGB(255, 180, 50),
	info    = Color3.fromRGB(91,  133, 197), -- Plague Accent Mavisi
}

local function notifyActiveCount()
	local count = 0
	for _, item in ipairs(NOTIFY_ACTIVE) do
		local card = item.Card or item
		if card and card.Parent then count = count + 1 end
	end
	return count
end

local function notifyCleanActive()
	local clean = {}
	for _, item in ipairs(NOTIFY_ACTIVE) do
		local card = item.Card or item
		if card and card.Parent then
			clean[#clean+1] = item
		end
	end
	NOTIFY_ACTIVE = clean
end

local function processQueue()
	if NOTIFY_PROCESSING then return end
	NOTIFY_PROCESSING = true
	task.spawn(function()
		while #NOTIFY_QUEUE > 0 do
			notifyCleanActive()
			if notifyActiveCount() < NOTIFY_MAX_STACK then
				local cfg = table.remove(NOTIFY_QUEUE, 1)
				if cfg then
					library:_ShowNotify(cfg)
				end
			end
			task.wait(0.08)
		end
		NOTIFY_PROCESSING = false
	end)
end

