function library:AddHitLog(configOrText, tag, tagColor, duration)
	if library.HitLogsEnabled == false then return end

	local tagStr = "HIT"
	local tagCol = Color3.fromRGB(80, 220, 120)
	local message = ""
	local dur = 2.2

	if type(configOrText) == "table" then
		tagStr = configOrText.Tag or configOrText.tag or "HIT"
		tagCol = configOrText.TagColor or configOrText.Color or configOrText.color or (tagStr == "MISS" and Color3.fromRGB(240, 80, 80) or Color3.fromRGB(80, 220, 120))
		dur = tonumber(configOrText.Duration or configOrText.duration) or 2.2

		if configOrText.Text or configOrText.text or configOrText.Message then
			message = tostring(configOrText.Text or configOrText.text or configOrText.Message)
		elseif configOrText.Target then
			local target = tostring(configOrText.Target)
			local part = tostring(configOrText.Part or "Head")
			local damage = tonumber(configOrText.Damage) or 100
			local remaining = configOrText.Remaining ~= nil and tostring(configOrText.Remaining) or "0"
			local distStr = configOrText.Distance and (" [" .. tostring(configOrText.Distance) .. "m]") or ""
			message = "Hit <b><font color=\"#ffffff\">" .. target .. "</font></b> in the <b><font color=\"#5b85c5\">" .. part .. "</font></b> for <b><font color=\"#50dc78\">" .. damage .. " dmg</font></b> (" .. remaining .. " hp left)" .. distStr
		else
			message = "Hit registered"
		end
	else
		message = tostring(configOrText or "Hit registered")
		if tag ~= nil then tagStr = tostring(tag) end
		if tagColor ~= nil then
			if typeof(tagColor) == "Color3" then
				tagCol = tagColor
			elseif type(tagColor) == "number" then
