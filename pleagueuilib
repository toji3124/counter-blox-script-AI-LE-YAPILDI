		Distance = distance,
		Duration = 2.2
	})
end

function library:MissLog(target, reason, distance)
	local r = reason or "spread"
	local dist = distance and (" [" .. tostring(distance) .. "m]") or ""
	return library:AddHitLog({
		Tag = "MISS",
		TagColor = Color3.fromRGB(240, 80, 80),
		Text = "Missed shot at <b><font color=\"#ffffff\">" .. tostring(target or "target") .. "</font></b> (" .. tostring(r) .. ")" .. dist,
		Duration = 2.2
	})
end

function library:Log(text, tag, color, duration)
	return library:AddHitLog(text, tag, color, duration)
end

function library:SetHitLogsEnabled(enabled)
	library.HitLogsEnabled = (enabled == true)
	HitLogModule.Enabled = library.HitLogsEnabled
	if not library.HitLogsEnabled and HitLogModule.Holder then
		for _, log in ipairs(HitLogModule.ActiveLogs) do
			if log and log.Frame then pcall(function() log.Frame:Destroy() end) end
		end
		HitLogModule.ActiveLogs = {}
	end
end

function library:SetHitLogPosition(newPos, newAnchor)
	if typeof(newPos) == "UDim2" then
		HitLogModule.Position = newPos
		if HitLogModule.Holder then HitLogModule.Holder.Position = newPos end
	end
	if typeof(newAnchor) == "Vector2" then
		HitLogModule.AnchorPoint = newAnchor
		if HitLogModule.Holder then HitLogModule.Holder.AnchorPoint = newAnchor end
	end
end

function library:ClearHitLogs()
	if HitLogModule.Holder then
		for _, log in ipairs(HitLogModule.ActiveLogs) do
			if log and log.Frame then pcall(function() log.Frame:Destroy() end) end
		end
		HitLogModule.ActiveLogs = {}
	end
end

function library:Init(name)
    for i,v in pairs(Upper:GetChildren()) do
        if v:IsA('TextButton') then
            if v.Name == name then
                TweenService:Create(v , TweenInfo.new(0.26, Enum.EasingStyle.Quad , Enum.EasingDirection.InOut), {TextColor3 = Color3.fromRGB(210, 210, 210)}):Play()	
            else
                TweenService:Create(v , TweenInfo.new(0.26, Enum.EasingStyle.Quad , Enum.EasingDirection.InOut), {TextColor3 = Color3.fromRGB(138, 138, 138)}):Play()	
            end
        end
    end
    for i,v in pairs(limit1:GetChildren()) do
        if v:IsA('Frame') or v:IsA('ScrollingFrame') then
            if v.Name == name then
                v.Visible = true
            else
                v.Visible = false
            end
        end
    end
end

