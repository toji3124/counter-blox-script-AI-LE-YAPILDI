		TweenService:Create(Accent, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(TagLabel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
		TweenService:Create(TextLabel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
		fadeTween:Play()
		fadeTween.Completed:Connect(function()
			for idx, item in ipairs(HitLogModule.ActiveLogs) do
				if item == logItem then
					table.remove(HitLogModule.ActiveLogs, idx)
					break
				end
			end
			pcall(function() LogCard:Destroy() end)
		end)
	end)

	return logItem
end

