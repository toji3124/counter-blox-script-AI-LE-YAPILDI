				Size = UDim2.new(1, 0, 0, 0)
			}):Play()
		end)
		task.delay(0.22, function()
			pcall(function() Card:Destroy() end)
			notifyCleanActive()
			processQueue()
		end)
	end

	function cardObj:StartTimer()
		if self.Closed or self.Persistent then
			BarBG.Visible = false
			return
		end

		BarBG.Visible = true
		self.Token = self.Token + 1
		local currentToken = self.Token
		self.Elapsed = 0

		if self.BarTween then pcall(function() self.BarTween:Cancel() end) end
		Bar.Size = UDim2.new(1, 0, 1, 0)
		self.BarTween = TweenService:Create(Bar, TweenInfo.new(self.Dur, Enum.EasingStyle.Linear, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 1, 0)
		})
		self.BarTween:Play()

		task.spawn(function()
			local step = 0.05
			while not self.Closed and self.Token == currentToken and self.Elapsed < self.Dur do
				task.wait(step)
				if not self.Paused and self.Token == currentToken then
					self.Elapsed = self.Elapsed + step
				end
			end
			if not self.Closed and self.Token == currentToken and not self.Paused then
				self:Close()
			end
		end)
	end

	function cardObj:Update(newCfg)
		if self.Closed then return end

		-- Başlık
		if newCfg.Title or newCfg.title then
			self.Title = newCfg.Title or newCfg.title
			TitleLabel.Text = self.Title
		end

		-- Açıklama
		if newCfg.Text or newCfg.text or newCfg.desc or newCfg.Message then
			self.Desc = newCfg.Text or newCfg.text or newCfg.desc or newCfg.Message
			DescLabel.Text = self.Desc
		end

		-- Süre
		local newDur = tonumber(newCfg.Duration or newCfg.duration or newCfg.dur or newCfg.Time)
		if newDur ~= nil then
			self.Dur = newDur
		end
		if newCfg.Persistent ~= nil then
			self.Persistent = newCfg.Persistent
		elseif newDur == 0 then
			self.Persistent = true
		end

		-- Renk / Tip
		local typeKey = newCfg.Type or newCfg.type
		if typeKey and NOTIFY_TYPE_COLORS[tostring(typeKey):lower()] then
			self.Color = NOTIFY_TYPE_COLORS[tostring(typeKey):lower()]
		elseif newCfg.Color or newCfg.color or newCfg.AccentColor then
			self.Color = newCfg.Color or newCfg.color or newCfg.AccentColor
		end

		Accent.BackgroundColor3 = self.Color
		Bar.BackgroundColor3 = self.Color

		-- Güncellenme nabzı (Plague mavi parıltı)
		pcall(function()
			CardStroke.Color = self.Color
			CardStroke.Transparency = 0.2
			TweenService:Create(CardStroke, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Color = Color3.fromRGB(52, 52, 52),
				Transparency = 0.5
			}):Play()
		end)

		-- Zamanlayıcıyı baştan başlat (süreyi asla bozmaz!)
		self:StartTimer()
	end

	-- Hover işlemleri
	ClickBtn.MouseEnter:Connect(function()
		if cardObj.Closed then return end
		cardObj.Paused = true
